# Express REST API configuration. Public project key keeps caller RLS active.
# Copy to .env locally. Supply real secrets through deployment secret storage.
# Set production (or staging) for controlled staging; both enforce HTTPS origins.
NODE_ENV=development
PORT=3000
FRONTEND_ORIGIN=http://localhost:5173
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_ANON_KEY is accepted as an alternative public-key name.
SUPABASE_ANON_KEY=
# Privileged server-only domain-write/worker access; never use for ordinary user CRUD.
SUPABASE_SERVICE_ROLE_KEY=
# Sandbox only in the MVP. Client secret and OAuth access tokens stay on the backend.
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# AI is optional: disabled means assistant unavailable, deterministic features still work.
AI_PROVIDER=gemini
AI_MODEL=
AI_API_KEY=
# Phase 5 analysis persistence/review requires the server-only service-role binding.
# It executes only narrow intelligence RPCs; ordinary reads/CRUD still use caller RLS.

# Gemini is backend-only. Explicitly select a model available to your key.
AI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=

# Live validation is disabled by default. Set only for an authorized isolated project.
ALLOW_LIVE_VALIDATION=false
DEPLOYMENT_ENVIRONMENT=
STAGING_TEST_ACCOUNTS_CONFIRMED=false
STAGING_PROJECT_REF=
STAGING_TEST_USER_A_EMAIL=
STAGING_TEST_USER_A_PASSWORD=
STAGING_TEST_USER_B_EMAIL=
STAGING_TEST_USER_B_PASSWORD=
