{
  "name": "subguard-ai-backend",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "test": "node --test test/*.test.js",
    "lint": "eslint src test",
    "build": "node --check src/server.js && node --check src/app.js",
    "ai:models": "node --env-file-if-exists=.env scripts/gemini-models.js",
    "ai:smoke": "node --env-file-if-exists=.env scripts/gemini-smoke.js",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=\"src/**\" test/*.test.js",
    "check:syntax": "find src scripts test -name '*.js' -type f -print0 | xargs -0 -n 1 node --check"
  },
  "dependencies": {
    "@google/genai": "3.0.0",
    "@supabase/supabase-js": "2.119.0",
    "cors": "2.8.6",
    "express": "5.3.0",
    "express-rate-limit": "8.7.3",
    "helmet": "8.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "supertest": "7.3.2"
  }
}
