# PUBLIC browser configuration only. Vite embeds every VITE_* value in the bundle.
# Copy to .env.local when Phase 2/3 introduces the application.
VITE_API_BASE_URL=http://localhost:3000/api/v1
VITE_SUPABASE_URL=
# Publishable key only; never a secret key or service-role key.
VITE_SUPABASE_PUBLISHABLE_KEY=
