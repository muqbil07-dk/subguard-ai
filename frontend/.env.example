# PUBLIC browser configuration only. Vite embeds every VITE_* value in the bundle.
# The synthetic assistant uses the explicit demo backend; account mode uses Auth.
VITE_API_BASE_URL=http://localhost:3000/api
VITE_SUPABASE_URL=
# Publishable key only; never a secret key or service-role key.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Public anon key; publishable-key alias above is also supported.
VITE_SUPABASE_ANON_KEY=
